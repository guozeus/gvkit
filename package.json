  "license": "UNLICENSED",
  "devDependencies": {
    "@types/node": "^22.15.17",
    "esbuild": "0.25.5",
    "happy-dom": "20.14.0",
    "obsidian": "^1.13.1",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "uuid": "^14.0.2"
  }
}
